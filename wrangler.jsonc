{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoopin-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoopin-db",
      "database_id": "f4f3f2b3-1885-465c-a450-51144ea2a301",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Dev-only auth stub toggle — see src/lib/auth.ts. Must be "false" (or
    // unset) once Clerk (or another real issuer) is wired in.
    "DEV_AUTH": "false"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
