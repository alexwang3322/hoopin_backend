{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoopin-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoopin-db",
      "database_id": "f4f3f2b3-1885-465c-a450-51144ea2a301",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Dev-only auth stub toggle — see src/lib/auth.ts. Must be "false" (or
    // unset) once Clerk (or another real issuer) is wired in.
    "DEV_AUTH": "false"
  },
  "triggers": {
    // Weekly, Monday 00:00 UTC — fires src/index.ts's `scheduled` handler,
    // which shifts any past-due runs.startsAt/endsAt forward by whole
    // weeks (src/lib/refreshDates.ts). Not exercised by `wrangler dev`;
    // trigger it locally with `wrangler dev --test-scheduled` and a
    // `curl "http://localhost:8787/__scheduled"` request, or after deploy.
    "crons": ["0 0 * * 1"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
